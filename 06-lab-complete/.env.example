# Copy thành .env rồi điền giá trị thật: cp .env.example .env  (.env nằm trong .gitignore)

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — đặt key ngẫu nhiên, vd: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# Redis (docker-compose tự đặt redis://redis:6379/0 cho service agent)
REDIS_URL=redis://localhost:6379/0

# Rate limit & cost guard
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
